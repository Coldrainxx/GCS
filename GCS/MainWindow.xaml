<Window x:Class="GCS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:GCS.Views"
        mc:Ignorable="d"
        Title="Ground Control Station" 
        Height="900" 
        Width="1600"
        Background="#0A0E14"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!-- Modern Aviation Theme Colors -->
        <SolidColorBrush x:Key="DarkBackground" Color="#0A0E14"/>
        <SolidColorBrush x:Key="PanelBackground" Color="#151922"/>
        <SolidColorBrush x:Key="CardBackground" Color="#1C2128"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2D333D"/>
        <SolidColorBrush x:Key="PrimaryText" Color="#E6EDF3"/>
        <SolidColorBrush x:Key="SecondaryText" Color="#8B949E"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#58A6FF"/>
        <SolidColorBrush x:Key="AccentCyan" Color="#39D0D8"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#3FB950"/>
        <SolidColorBrush x:Key="AccentOrange" Color="#FF9500"/>
        <SolidColorBrush x:Key="AccentRed" Color="#F85149"/>

        <!-- Modern Button Style -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"
                                            Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2D333D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#373E47"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <!-- Top Bar -->
                <RowDefinition Height="Auto"/>
                <!-- Action Bar -->
                <RowDefinition/>
                <!-- Main Content -->
                <RowDefinition Height="50"/>
                <!-- Bottom Panel -->
            </Grid.RowDefinitions>

            <!-- TOP BAR -->
            <Border Grid.Row="0" 
                    Background="{StaticResource PanelBackground}" 
                    BorderBrush="{StaticResource BorderBrush}" 
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Link + Params buttons -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                Margin="10,0,0,0" VerticalAlignment="Center">
                        <Button Style="{StaticResource ModernButtonStyle}"
                                Click="LinkButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <!-- Status Indicator -->
                                <Ellipse Width="10" Height="10" Margin="0,0,10,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource AccentRed}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Telemetry.IsConnected}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource AccentGreen}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>

                                <TextBlock Text="LINK"
                                          FontWeight="Bold"
                                          FontSize="14"
                                          Foreground="{StaticResource PrimaryText}"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="ParamsButton"
                                Style="{StaticResource ModernButtonStyle}"
                                Margin="8,0,0,0"
                                Click="ParamsButton_Click">
                            <TextBlock Text="⚙ PARAMS"
                                      FontWeight="Bold"
                                      FontSize="14"
                                      Foreground="{StaticResource PrimaryText}"/>
                        </Button>

                        <Button x:Name="SetupButton"
                                Style="{StaticResource ModernButtonStyle}"
                                Margin="8,0,0,0"
                                Click="SetupButton_Click">
                            <TextBlock Text="🛠 SETUP"
                                      FontWeight="Bold"
                                      FontSize="14"
                                      Foreground="{StaticResource PrimaryText}"/>
                        </Button>

                        <Button x:Name="SwarmButton"
                                Margin="8,0,0,0"
                                Click="SwarmButton_Click">
                            <Button.Style>
                                <!-- Lights up while swarm mode is engaged. -->
                                <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSwarmMode}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentCyan}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentCyan}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🛩 SWARM"
                                          FontWeight="Bold"
                                          FontSize="14">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSwarmMode}" Value="True">
                                                    <Setter Property="Foreground" Value="#0A0E14"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Border Background="#0A0E14" CornerRadius="8"
                                        Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding Swarm.HasSwarm, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding Swarm.Count}" Foreground="{StaticResource AccentCyan}"
                                              FontSize="11" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </Button>

                    </StackPanel>

                    <!-- Center: Vehicle Info - Fixed Alignment -->
                    <StackPanel Grid.Column="1" 
                                Orientation="Horizontal" 
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                        <!-- Armed Status Badge -->
                        <Border CornerRadius="4" 
                                Padding="10,4" 
                                Margin="0,0,20,0"
                                VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#3FB950"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Telemetry.IsArmed}" Value="True">
                                            <Setter Property="Background" Value="#F85149"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding Telemetry.ArmedStatus}"
                                      Foreground="White"
                                      FontSize="12"
                                      FontWeight="Bold"/>
                        </Border>

                        <!-- Vehicle ID -->
                        <TextBlock Text="VEHICLE" 
                                  Foreground="{StaticResource SecondaryText}"
                                  FontSize="11"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Telemetry.SystemId}" 
                                  Foreground="{StaticResource AccentCyan}"
                                  FontSize="14"
                                  FontWeight="Bold"
                                  VerticalAlignment="Center"
                                  Margin="0,0,3,0"/>
                        <TextBlock Text=":" 
                                  Foreground="{StaticResource SecondaryText}"
                                  FontSize="14"
                                  VerticalAlignment="Center"
                                  Margin="0,0,3,0"/>
                        <TextBlock Text="{Binding Telemetry.ComponentId}" 
                                  Foreground="{StaticResource AccentCyan}"
                                  FontSize="14"
                                  FontWeight="Bold"
                                  VerticalAlignment="Center"
                                  Margin="0,0,20,0"/>

                        <!-- Flight Mode -->
                        <TextBlock Text="MODE:" 
                                  Foreground="{StaticResource SecondaryText}"
                                  FontSize="11"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Telemetry.FlightMode}" 
                                  Foreground="{StaticResource AccentOrange}"
                                  FontSize="14"
                                  FontWeight="Bold"
                                  VerticalAlignment="Center"
                                  Margin="0,0,20,0"/>

                        <!-- Weather Button -->
                        <Button x:Name="WeatherButton"
                                Command="{Binding Weather.TogglePopupCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Padding="8,4"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="☁" 
                                          FontSize="16" 
                                          Foreground="{StaticResource PrimaryText}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding Weather.Temperature, StringFormat={}{0:F0}°C}"
                                          Foreground="{StaticResource PrimaryText}"
                                          FontSize="12"
                                          FontWeight="Bold"
                                          VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Weather Popup -->
                        <Popup IsOpen="{Binding Weather.IsPopupOpen}"
                               PlacementTarget="{Binding ElementName=WeatherButton}"
                               Placement="Bottom"
                               StaysOpen="False"
                               AllowsTransparency="True">
                            <Border Background="#1C2128"
                                    BorderBrush="#2D333D"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16"
                                    Margin="8">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="20" Opacity="0.5" ShadowDepth="4"/>
                                </Border.Effect>

                                <StackPanel Width="280">
                                    <!-- Header -->
                                    <Grid Margin="0,0,0,12">
                                        <TextBlock Text="Weather Conditions"
                                                  Foreground="#E6EDF3"
                                                  FontSize="14"
                                                  FontWeight="Bold"/>
                                        <Button Content="⟳" 
                                               Command="{Binding Weather.RefreshCommand}"
                                               HorizontalAlignment="Right"
                                               Background="Transparent"
                                               Foreground="#8B949E"
                                               BorderThickness="0"
                                               FontSize="14"
                                               Cursor="Hand"
                                               Padding="4"/>
                                    </Grid>

                                    <!-- Flight Condition Banner -->
                                    <Border CornerRadius="4" 
                                            Padding="10,8"
                                            Margin="0,0,0,12">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#1A3FB950"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Weather.IsGoodForFlight}" Value="False">
                                                        <Setter Property="Background" Value="#1AF85149"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Weather.FlightConditionText}"
                                                  Foreground="{Binding Weather.FlightConditionColor}"
                                                  FontWeight="Bold"
                                                  FontSize="12"
                                                  HorizontalAlignment="Center"/>
                                    </Border>

                                    <!-- Weather Details Grid -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Row 0: Temperature & Humidity -->
                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                                            <TextBlock Text="TEMPERATURE" Foreground="#8B949E" FontSize="9" FontWeight="Bold"/>
                                            <TextBlock Foreground="#39D0D8" FontSize="18" FontWeight="Bold">
                                                <Run Text="{Binding Weather.Temperature, StringFormat={}{0:F1}}"/><Run Text="°C"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                                            <TextBlock Text="HUMIDITY" Foreground="#8B949E" FontSize="9" FontWeight="Bold"/>
                                            <TextBlock Foreground="#39D0D8" FontSize="18" FontWeight="Bold">
                                                <Run Text="{Binding Weather.Humidity}"/><Run Text="%"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Row 1: Wind -->
                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,10">
                                            <TextBlock Text="WIND SPEED" Foreground="#8B949E" FontSize="9" FontWeight="Bold"/>
                                            <TextBlock Foreground="#E6EDF3" FontSize="14">
                                                <Run Text="{Binding Weather.WindSpeed, StringFormat={}{0:F1}}"/><Run Text=" km/h"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                                            <TextBlock Text="WIND DIR" Foreground="#8B949E" FontSize="9" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Weather.WindDirection}" 
                                                      Foreground="#E6EDF3" FontSize="14"/>
                                        </StackPanel>

                                        <!-- Row 2: Visibility & Pressure -->
                                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,10">
                                            <TextBlock Text="VISIBILITY" Foreground="#8B949E" FontSize="9" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Weather.VisibilityText}" 
                                                      Foreground="#E6EDF3" FontSize="14"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,10">
                                            <TextBlock Text="PRESSURE" Foreground="#8B949E" FontSize="9" FontWeight="Bold"/>
                                            <TextBlock Foreground="#E6EDF3" FontSize="14">
                                                <Run Text="{Binding Weather.Pressure, StringFormat={}{0:F0}}"/><Run Text=" hPa"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Row 3: Description -->
                                        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2">
                                            <TextBlock Text="CONDITIONS" Foreground="#8B949E" FontSize="9" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Weather.Description}" 
                                                      Foreground="#FF9500" 
                                                      FontSize="12"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Last Updated -->
                                    <TextBlock Text="{Binding Weather.LastUpdated, StringFormat=Updated: {0}}"
                                              Foreground="#4A5158"
                                              FontSize="10"
                                              HorizontalAlignment="Right"
                                              Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>

                    <!-- Right: Window Controls -->
                    <StackPanel Grid.Column="2" 
                                Orientation="Horizontal"
                                Margin="0,0,10,0">
                        <Button Content="─" 
                                Width="40" Height="40"
                                Style="{StaticResource ModernButtonStyle}"
                                Click="MinimizeButton_Click"/>
                        <Button Content="□" 
                                Width="40" Height="40"
                                Style="{StaticResource ModernButtonStyle}"
                                Click="MaximizeButton_Click"/>
                        <Button Content="✕" 
                                Width="40" Height="40"
                                Style="{StaticResource ModernButtonStyle}"
                                Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ACTION BAR -->
            <Border Grid.Row="1"
                    Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="10,6">
                <Grid>
                    <!-- SINGLE-VEHICLE: acts on the active vehicle -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding IsSingleVehicleMode, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Button Content="ARM" Style="{StaticResource ModernButtonStyle}"
                                Background="{StaticResource AccentGreen}" Foreground="White"
                                Command="{Binding Actions.ArmCommand}" Margin="0,0,6,0"/>
                        <Button Content="DISARM" Style="{StaticResource ModernButtonStyle}"
                                Background="{StaticResource AccentRed}" Foreground="White"
                                Command="{Binding Actions.DisarmCommand}" Margin="0,0,16,0"/>

                        <TextBlock Text="MODE" Foreground="{StaticResource SecondaryText}" FontSize="11"
                                   FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox Width="140" VerticalAlignment="Center"
                                  ItemsSource="{Binding Actions.AvailableModes}"
                                  SelectedIndex="{Binding Actions.SelectedModeIndex}"/>
                        <Button Content="SET" Style="{StaticResource ModernButtonStyle}"
                                Command="{Binding Actions.SetModeCommand}" Margin="6,0,16,0"/>

                        <Button Content="RTL" Style="{StaticResource ModernButtonStyle}"
                                Background="{StaticResource AccentOrange}" Foreground="White"
                                Command="{Binding Actions.RtlCommand}" Margin="0,0,6,0"/>
                        <Button Content="LOITER" Style="{StaticResource ModernButtonStyle}"
                                Command="{Binding Actions.LoiterCommand}" Margin="0,0,6,0"/>
                        <Button Content="QLAND" Style="{StaticResource ModernButtonStyle}"
                                Command="{Binding Actions.QLandCommand}" Margin="0,0,6,0"/>
                    </StackPanel>

                    <!-- SWARM: every command acts on the whole fleet -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding IsSwarmMode, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Background="#1A39D0D8" BorderBrush="{StaticResource AccentCyan}"
                                BorderThickness="1" CornerRadius="3" Padding="8,3" Margin="0,0,14,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="SWARM MODE — COMMANDS AFFECT ALL VEHICLES"
                                       Foreground="{StaticResource AccentCyan}" FontSize="10" FontWeight="Bold"/>
                        </Border>

                        <Button Content="ARM ALL" Style="{StaticResource ModernButtonStyle}"
                                Background="{StaticResource AccentGreen}" Foreground="White"
                                Command="{Binding Swarm.ArmAllCommand}" Margin="0,0,6,0"/>
                        <Button Content="DISARM ALL" Style="{StaticResource ModernButtonStyle}"
                                Background="{StaticResource AccentRed}" Foreground="White"
                                Command="{Binding Swarm.DisarmAllCommand}" Margin="0,0,16,0"/>

                        <TextBlock Text="MODE" Foreground="{StaticResource SecondaryText}" FontSize="11"
                                   FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox Width="140" VerticalAlignment="Center"
                                  ItemsSource="{Binding Swarm.AvailableModes}"
                                  SelectedIndex="{Binding Swarm.SelectedModeIndex}"/>
                        <Button Content="SET ALL" Style="{StaticResource ModernButtonStyle}"
                                Command="{Binding Swarm.SetModeAllCommand}" Margin="6,0,16,0"/>

                        <Button Content="RTL ALL" Style="{StaticResource ModernButtonStyle}"
                                Background="{StaticResource AccentOrange}" Foreground="White"
                                Command="{Binding Swarm.RtlAllCommand}" Margin="0,0,6,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- MAIN CONTENT -->
            <Grid x:Name="MainContentGrid" Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="FlightPanelColumn" Width="500" MinWidth="380" MaxWidth="900"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="400"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT PANEL: single-vehicle flight data, or the swarm roster -->
                <Border Grid.Column="0"
                        Background="{StaticResource PanelBackground}">
                    <!-- Always present. It gains a SWARM tab in swarm mode, so MISSION,
                         DATA, MESSAGES and the rest stay available in both modes. -->
                    <views:FlightPanelView DataContext="{Binding Telemetry}"/>
                </Border>

                <!-- Drag to resize the flight panel / map split -->
                <GridSplitter Grid.Column="1" Width="6"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Background="{StaticResource BorderBrush}"
                              ShowsPreview="False" Cursor="SizeWE"/>

                <!-- RIGHT PANEL: Map -->
                <Border Grid.Column="2"
                        Background="{StaticResource DarkBackground}">
                    <views:MapView DataContext="{Binding Telemetry}"/>
                </Border>
            </Grid>

            <!-- BOTTOM PANEL: Alerts -->
            <Border Grid.Row="3"
                    Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                <views:AlertsPanelView DataContext="{Binding Alerts}"/>
            </Border>

            <!-- CONNECTION POPUP (Hidden by default) -->
            <Border x:Name="ConnectionPopup"
                    Grid.Row="2"
                    Width="400"
                    Height="500"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="10,10,0,0"
                    Background="{StaticResource CardBackground}"
                    BorderBrush="{StaticResource AccentCyan}"
                    BorderThickness="2"
                    CornerRadius="8"
                    Visibility="Collapsed"
                    Panel.ZIndex="100">
                <Border.Effect>
                    <DropShadowEffect Color="Black" 
                                    BlurRadius="30" 
                                    ShadowDepth="0" 
                                    Opacity="0.7"/>
                </Border.Effect>
                <views:ConnectionView DataContext="{Binding Connection}"/>
            </Border>

            <!-- FULL-WINDOW PARAMETERS VIEW (toggled by the Params button) -->
            <Border x:Name="ParamsView"
                    Grid.Row="2"
                    Background="{StaticResource PanelBackground}"
                    Visibility="Collapsed"
                    Panel.ZIndex="90">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header with close -->
                    <Grid Grid.Row="0" Background="{StaticResource CardBackground}">
                        <TextBlock Text="PARAMETERS"
                                   FontWeight="Bold" FontSize="14"
                                   Foreground="{StaticResource AccentCyan}"
                                   VerticalAlignment="Center" Margin="16,10"/>
                        <Button Content="✕ CLOSE"
                                HorizontalAlignment="Right" Margin="0,6,10,6"
                                Style="{StaticResource ModernButtonStyle}"
                                Click="ParamsButton_Click"/>
                    </Grid>

                    <views:ParametersTabView Grid.Row="1" DataContext="{Binding Parameters}"/>
                </Grid>
            </Border>

            <!-- FULL-WINDOW SETUP VIEW (Mandatory Hardware; toggled by the Setup button) -->
            <Border x:Name="SetupPanel"
                    Grid.Row="2"
                    Background="{StaticResource PanelBackground}"
                    Visibility="Collapsed"
                    Panel.ZIndex="90">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Background="{StaticResource CardBackground}">
                        <TextBlock Text="SETUP"
                                   FontWeight="Bold" FontSize="14"
                                   Foreground="{StaticResource AccentCyan}"
                                   VerticalAlignment="Center" Margin="16,10"/>
                        <Button Content="✕ CLOSE"
                                HorizontalAlignment="Right" Margin="0,6,10,6"
                                Style="{StaticResource ModernButtonStyle}"
                                Click="SetupButton_Click"/>
                    </Grid>

                    <views:SetupView Grid.Row="1" DataContext="{Binding Setup}"/>
                </Grid>
            </Border>

            <!-- Toast notifications overlay (click-through except over a toast) -->
            <views:ToastHost Grid.Row="0" Grid.RowSpan="4"
                             DataContext="{Binding Toasts}" Panel.ZIndex="200"/>
        </Grid>
    </Border>
</Window>
