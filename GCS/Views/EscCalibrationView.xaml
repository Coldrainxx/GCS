<UserControl x:Class="GCS.Views.EscCalibrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="720">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="ESC CALIBRATION" Foreground="#39D0D8" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

            <!-- Safety warning -->
            <Border Background="#2A1416" BorderBrush="#F85149" BorderThickness="1" CornerRadius="6"
                    Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="⚠ REMOVE ALL PROPELLERS FIRST" Foreground="#F85149"
                               FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#E6EDF3" FontSize="12"
                               Text="ESC calibration makes the motors run. Take the propellers off and keep clear of the motors before doing any of this."/>
                </StackPanel>
            </Border>

            <TextBlock TextWrapping="Wrap" Foreground="#8B949E" FontSize="12" Margin="0,0,0,14"
                       Text="All ESCs should share the same throttle endpoints so the motors spin up together. On QuadPlane this is done with the all-at-once throttle passthrough procedure (there is no in-app automated calibration — it must be driven from the throttle stick at boot):"/>

            <Border Background="#1C2128" BorderBrush="#2D333D" BorderThickness="1" CornerRadius="6" Padding="18">
                <StackPanel>
                    <TextBlock Foreground="#E6EDF3" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="1.  Remove the propellers. Disconnect the flight battery."/>
                    <TextBlock Foreground="#E6EDF3" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="2.  Turn on the transmitter and set the throttle stick to MAXIMUM."/>
                    <TextBlock Foreground="#E6EDF3" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="3.  Connect the flight battery. The autopilot boots — wait for the ESC calibration tones/LEDs."/>
                    <TextBlock Foreground="#E6EDF3" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="4.  When you hear the tones confirming max throttle was detected, lower the throttle stick to MINIMUM."/>
                    <TextBlock Foreground="#E6EDF3" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="5.  The ESCs confirm the minimum endpoint (more tones). Calibration is now stored in each ESC."/>
                    <TextBlock Foreground="#E6EDF3" FontSize="13" TextWrapping="Wrap"
                               Text="6.  Disconnect the battery, return the throttle to minimum, and reconnect normally to fly."/>
                </StackPanel>
            </Border>

            <TextBlock TextWrapping="Wrap" Foreground="#8B949E" FontSize="11" Margin="2,14,0,0"
                       Text="Tone/LED patterns vary by ESC make — check your ESC manual. If the motors don't spin evenly afterwards, repeat the procedure."/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
