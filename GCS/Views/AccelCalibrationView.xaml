<UserControl x:Class="GCS.Views.AccelCalibrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="720">
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#1C2128"/>
            <Setter Property="BorderBrush" Value="#2D333D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Background" Value="#1C2128"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="BorderBrush" Value="#2D333D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="ACCELEROMETER CALIBRATION" Foreground="#39D0D8"
                       FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock TextWrapping="Wrap" Foreground="#8B949E" FontSize="12" Margin="0,0,0,16"
                       Text="Calibrate the board level for accurate horizon, or run the full 6-point calibration. Keep the vehicle perfectly still in each position."/>

            <!-- Level -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Level Horizon" Foreground="#39D0D8" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#8B949E" FontSize="12" Margin="0,0,0,10"
                               Text="Set the vehicle exactly as it sits in level flight, keep it still, then calibrate."/>
                    <Button Content="CALIBRATE LEVEL" Style="{StaticResource Btn}" HorizontalAlignment="Left"
                            Command="{Binding LevelCommand}" Foreground="#39D0D8"/>
                </StackPanel>
            </Border>

            <!-- 6-point -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Full Accelerometer (6-point)" Foreground="#39D0D8"
                               FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>

                    <TextBlock Text="{Binding StepText}" Foreground="#3FB950" FontWeight="Bold" FontSize="14"
                               Margin="0,0,0,4"
                               Visibility="{Binding IsCalibrating, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding Instruction}" TextWrapping="Wrap" Foreground="#E6EDF3"
                               FontSize="14" Margin="0,0,0,12"/>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="▶ START ACCEL CAL" Style="{StaticResource Btn}"
                                Command="{Binding StartCommand}"/>
                        <Button Content="NEXT POSITION ▶" Style="{StaticResource Btn}" Margin="8,0,0,0"
                                Command="{Binding NextCommand}" Foreground="#3FB950"/>
                        <Button Content="✕ CANCEL" Style="{StaticResource Btn}" Margin="8,0,0,0"
                                Command="{Binding CancelCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Vehicle messages -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Vehicle Messages" Foreground="#8B949E" FontWeight="Bold"
                               FontSize="12" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding Log}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="#C9D1D9" FontFamily="Consolas"
                                           FontSize="12" Margin="0,1" TextWrapping="Wrap"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding Status}" Foreground="#8B949E" FontSize="12"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
