<UserControl x:Class="GCS.Views.FirmwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="900">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <SolidColorBrush x:Key="Panel" Color="#151922"/>
        <SolidColorBrush x:Key="Card" Color="#1C2128"/>
        <SolidColorBrush x:Key="Border" Color="#2D333D"/>
        <SolidColorBrush x:Key="Primary" Color="#E6EDF3"/>
        <SolidColorBrush x:Key="Secondary" Color="#8B949E"/>
        <SolidColorBrush x:Key="Cyan" Color="#39D0D8"/>
        <SolidColorBrush x:Key="Orange" Color="#FF9500"/>

        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Card}"/>
            <Setter Property="Foreground" Value="{StaticResource Primary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Cyan}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Secondary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Cyan}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Card}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource Panel}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="20,16">
            <StackPanel MaxWidth="820" HorizontalAlignment="Left">

                <!-- 1. Official firmware -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="① OFFICIAL FIRMWARE (firmware.ardupilot.org)" Style="{StaticResource SectionTitle}"/>
                        <Button Content="⟲ LOAD FIRMWARE LIST" Style="{StaticResource Btn}"
                                Command="{Binding LoadManifestCommand}" HorizontalAlignment="Left" Margin="0,0,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="VEHICLE" Style="{StaticResource Lbl}"/>
                                <ComboBox ItemsSource="{Binding VehicleTypes}" SelectedItem="{Binding SelectedVehicleType}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="BOARD" Style="{StaticResource Lbl}"/>
                                <ComboBox ItemsSource="{Binding Boards}" SelectedItem="{Binding SelectedBoard}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                <TextBlock Text="VERSION" Style="{StaticResource Lbl}"/>
                                <ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedFirmware}"
                                          DisplayMemberPath="Display"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" VerticalAlignment="Bottom">
                                <Button Content="⬇ DOWNLOAD" Style="{StaticResource Btn}"
                                        Command="{Binding DownloadCommand}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 2. Local file -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="② OR LOCAL FILE" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <Button Content="📁 BROWSE .apj..." Style="{StaticResource Btn}"
                                Command="{Binding BrowseLocalCommand}"/>
                    </StackPanel>
                </Border>

                <!-- Loaded firmware info -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="LOADED FIRMWARE" Style="{StaticResource Lbl}"/>
                        <TextBlock Text="{Binding LoadedInfo}" Foreground="{StaticResource Primary}"
                                   FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 3. Board detection -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="③ BOARD" Style="{StaticResource SectionTitle}"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Secondary}" FontSize="12" Margin="0,0,0,10"
                                   Text="The board must be in bootloader mode to detect/flash. If it's running normally (streaming telemetry), reboot it to the bootloader while connected, or unplug/replug and Detect within a few seconds."/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <StackPanel Margin="0,0,10,0" Width="160">
                                <TextBlock Text="SERIAL PORT" Style="{StaticResource Lbl}"/>
                                <ComboBox ItemsSource="{Binding SerialPorts}" SelectedItem="{Binding SelectedPort}"/>
                            </StackPanel>
                            <Button Content="⟳" Style="{StaticResource Btn}" Command="{Binding RefreshPortsCommand}"
                                    VerticalAlignment="Bottom" Margin="0,0,10,0"/>
                            <Button Content="⭯ REBOOT TO BOOTLOADER" Style="{StaticResource Btn}"
                                    Command="{Binding RebootToBootloaderCommand}" VerticalAlignment="Bottom" Margin="0,0,10,0"/>
                            <Button Content="🔎 DETECT BOARD" Style="{StaticResource Btn}"
                                    Command="{Binding DetectCommand}" VerticalAlignment="Bottom"/>
                        </StackPanel>
                        <TextBlock Text="{Binding DetectedInfo}" Foreground="{StaticResource Primary}"
                                   FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding MatchInfo}" Foreground="{Binding MatchColor}"
                                   FontSize="12" FontWeight="Bold" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 4. Flash -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="④ FLASH" Style="{StaticResource SectionTitle}"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Secondary}" FontSize="12" Margin="0,0,0,10"
                                   Text="Flashing erases and reprograms the board. It auto-disconnects the vehicle to free the port. Keep the board powered and plugged in until it finishes; do not unplug during erase/program."/>
                        <Button Content="⚡ FLASH FIRMWARE" Style="{StaticResource Btn}"
                                Foreground="{StaticResource Orange}" Command="{Binding FlashCommand}" HorizontalAlignment="Left"/>
                        <ProgressBar Height="18" Margin="0,12,0,0" Minimum="0" Maximum="100"
                                     Value="{Binding FlashPercent, Mode=OneWay}"
                                     Foreground="{StaticResource Orange}" Background="#0D1117"
                                     BorderBrush="{StaticResource Border}"
                                     Visibility="{Binding Flashing, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Status bar -->
        <Border Grid.Row="1" Background="{StaticResource Card}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,0,0" Padding="16,8">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{Binding StatusColor}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>
