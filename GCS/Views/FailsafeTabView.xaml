<UserControl x:Class="GCS.Views.FailsafeTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="620" d:DesignWidth="440">
    <UserControl.Resources>
        <SolidColorBrush x:Key="Fg" Color="#E6EDF3"/>
        <SolidColorBrush x:Key="Muted" Color="#8B949E"/>
        <SolidColorBrush x:Key="Line" Color="#2D333D"/>
        <SolidColorBrush x:Key="Field" Color="#0D1117"/>
        <SolidColorBrush x:Key="Cyan" Color="#39D0D8"/>

        <!-- Grouped "GroupBox" like Mission Planner -->
        <Style x:Key="GroupCard" TargetType="HeaderedContentControl">
            <Setter Property="Foreground" Value="{StaticResource Cyan}"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="HeaderedContentControl">
                        <Border Background="#1C2128" BorderBrush="{StaticResource Line}"
                                BorderThickness="1" CornerRadius="6">
                            <DockPanel Margin="14,10,14,14">
                                <TextBlock DockPanel.Dock="Top" Text="{TemplateBinding Header}"
                                           Foreground="{StaticResource Cyan}" FontWeight="Bold"
                                           FontSize="13" Margin="0,0,0,10"/>
                                <ContentPresenter/>
                            </DockPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Num" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Field}"/>
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Width" Value="90"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>

        <Style x:Key="Chk" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="16">

        <!-- Header + refresh -->
        <Grid Margin="0,0,0,12">
            <TextBlock Text="FAILSAFE" Foreground="{StaticResource Cyan}" FontWeight="Bold" FontSize="15"/>
            <Button Content="⟳ READ" HorizontalAlignment="Right" Command="{Binding RefreshCommand}"
                    Background="#1C2128" Foreground="{StaticResource Fg}" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" Padding="12,5" FontWeight="Bold" Cursor="Hand"/>
        </Grid>

        <!-- BATTERY -->
        <HeaderedContentControl Header="Battery" Style="{StaticResource GroupCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Low Battery (V)" Style="{StaticResource Lbl}" Margin="0,0,0,8"/>
                <TextBox   Grid.Row="0" Grid.Column="1" Style="{StaticResource Num}" Margin="0,0,0,8"
                           Text="{Binding BattLowVolt, UpdateSourceTrigger=LostFocus, StringFormat=F1}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Reserved MAH" Style="{StaticResource Lbl}" Margin="0,0,0,8"/>
                <TextBox   Grid.Row="1" Grid.Column="1" Style="{StaticResource Num}" Margin="0,0,0,8"
                           Text="{Binding BattLowMah, UpdateSourceTrigger=LostFocus, StringFormat=F0}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Low Timer (s)" Style="{StaticResource Lbl}" Margin="0,0,0,10"/>
                <TextBox   Grid.Row="2" Grid.Column="1" Style="{StaticResource Num}" Margin="0,0,0,10"
                           Text="{Binding BattLowTimer, UpdateSourceTrigger=LostFocus, StringFormat=F0}"/>

                <ComboBox  Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                           ItemsSource="{Binding BatteryActions}"
                           SelectedValue="{Binding BattAction, Mode=TwoWay}"
                           SelectedValuePath="Value" DisplayMemberPath="Label"/>
            </Grid>
        </HeaderedContentControl>

        <!-- RADIO -->
        <HeaderedContentControl Header="Radio" Style="{StaticResource GroupCard}">
            <StackPanel>
                <Grid Margin="0,0,0,4">
                    <TextBlock Text="FS Pwm" Style="{StaticResource Lbl}"/>
                    <TextBox Style="{StaticResource Num}"
                             Text="{Binding FsPwm, UpdateSourceTrigger=LostFocus, StringFormat=F0}"/>
                </Grid>
                <CheckBox Content="Throttle FailSafe" Style="{StaticResource Chk}"
                          IsChecked="{Binding ThrottleFailsafe}"/>
            </StackPanel>
        </HeaderedContentControl>

        <!-- GCS -->
        <HeaderedContentControl Header="GCS" Style="{StaticResource GroupCard}">
            <StackPanel>
                <CheckBox Content="GCS FailSafe" Style="{StaticResource Chk}" IsChecked="{Binding GcsFailsafe}"/>
                <CheckBox Content="FailSafe Short (1 sec)" Style="{StaticResource Chk}" IsChecked="{Binding FailsafeShort}"/>
                <CheckBox Content="FailSafe Long (20 sec)" Style="{StaticResource Chk}" IsChecked="{Binding FailsafeLong}"/>
            </StackPanel>
        </HeaderedContentControl>

        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Muted}" FontSize="12" Margin="2,2,0,0"/>
    </StackPanel>
</UserControl>
