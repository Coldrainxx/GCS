<UserControl x:Class="GCS.Views.ServoOutputView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="860">
    <UserControl.Resources>
        <Style x:Key="MiniNum" TargetType="TextBox">
            <Setter Property="Background" Value="#0D1117"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="BorderBrush" Value="#2D333D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="3,3"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="SERVO OUTPUT" Foreground="#39D0D8"
                   FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="#8B949E" FontSize="12" Margin="0,0,0,12"
                   Text="Live PWM on each output, with its function, reverse and Min / Max / Trim endpoints (SERVOn_FUNCTION / REVERSED / MIN / MAX / TRIM). Changes are written to the vehicle."/>

        <!-- Column headers -->
        <Grid Grid.Row="2" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="66"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="42"/>
                <ColumnDefinition Width="58"/>
                <ColumnDefinition Width="58"/>
                <ColumnDefinition Width="58"/>
                <ColumnDefinition Width="48"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="OUTPUT" Foreground="#8B949E" FontSize="10" FontWeight="Bold"/>
            <TextBlock Grid.Column="1" Text="FUNCTION" Foreground="#8B949E" FontSize="10" FontWeight="Bold"/>
            <TextBlock Grid.Column="2" Text="REV" Foreground="#8B949E" FontSize="10" FontWeight="Bold"/>
            <TextBlock Grid.Column="3" Text="MIN" Foreground="#8B949E" FontSize="10" FontWeight="Bold"/>
            <TextBlock Grid.Column="4" Text="MAX" Foreground="#8B949E" FontSize="10" FontWeight="Bold"/>
            <TextBlock Grid.Column="5" Text="TRIM" Foreground="#8B949E" FontSize="10" FontWeight="Bold"/>
            <TextBlock Grid.Column="6" Text="PWM" Foreground="#8B949E" FontSize="10" FontWeight="Bold"/>
            <TextBlock Grid.Column="7" Text="LEVEL" Foreground="#8B949E" FontSize="10" FontWeight="Bold"/>
        </Grid>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Outputs}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="66"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="58"/>
                                <ColumnDefinition Width="58"/>
                                <ColumnDefinition Width="58"/>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Label}" Foreground="#E6EDF3"
                                       FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" Margin="0,0,8,0"
                                      ItemsSource="{Binding DataContext.Functions, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                      SelectedValue="{Binding FunctionValue, Mode=TwoWay}"
                                      SelectedValuePath="Value" DisplayMemberPath="Label"/>
                            <CheckBox Grid.Column="2" IsChecked="{Binding Reversed}" Cursor="Hand"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="3" Style="{StaticResource MiniNum}"
                                     Text="{Binding Min, UpdateSourceTrigger=LostFocus}"/>
                            <TextBox Grid.Column="4" Style="{StaticResource MiniNum}"
                                     Text="{Binding Max, UpdateSourceTrigger=LostFocus}"/>
                            <TextBox Grid.Column="5" Style="{StaticResource MiniNum}"
                                     Text="{Binding Trim, UpdateSourceTrigger=LostFocus}"/>
                            <TextBlock Grid.Column="6" Text="{Binding PwmText}" Foreground="#39D0D8"
                                       FontFamily="Consolas" FontSize="12" VerticalAlignment="Center"/>
                            <ProgressBar Grid.Column="7" Height="14" Minimum="1000" Maximum="2000"
                                         Value="{Binding Pwm, Mode=OneWay}"
                                         Background="#0D1117" Foreground="#3FB950" BorderBrush="#2D333D"
                                         BorderThickness="1" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="⟳ READ FUNCTIONS" Command="{Binding RefreshCommand}"
                    Background="#1C2128" Foreground="#E6EDF3" BorderBrush="#2D333D"
                    BorderThickness="1" Padding="14,7" FontWeight="Bold" Cursor="Hand"/>
            <TextBlock Text="{Binding Status}" Foreground="#8B949E" FontSize="12"
                       VerticalAlignment="Center" Margin="16,0,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
