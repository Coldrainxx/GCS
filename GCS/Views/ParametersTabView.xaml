<UserControl x:Class="GCS.Views.ParametersTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="520">

    <UserControl.Resources>
        <SolidColorBrush x:Key="Panel" Color="#151922"/>
        <SolidColorBrush x:Key="Card" Color="#1C2128"/>
        <SolidColorBrush x:Key="Border" Color="#2D333D"/>
        <SolidColorBrush x:Key="Primary" Color="#E6EDF3"/>
        <SolidColorBrush x:Key="Secondary" Color="#8B949E"/>
        <SolidColorBrush x:Key="Cyan" Color="#39D0D8"/>
        <SolidColorBrush x:Key="Green" Color="#3FB950"/>
        <SolidColorBrush x:Key="Orange" Color="#FF9500"/>

        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Card}"/>
            <Setter Property="Foreground" Value="{StaticResource Primary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Cyan}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource Panel}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0" Margin="8,8,8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource Card}" BorderBrush="{StaticResource Border}"
                    BorderThickness="1" CornerRadius="5" Padding="8,0" Margin="0,0,8,0">
                <Grid>
                    <TextBlock Text="Filter parameters..." Foreground="{StaticResource Secondary}"
                               VerticalAlignment="Center" FontSize="12" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Filter}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent" BorderThickness="0" Foreground="{StaticResource Primary}"
                             VerticalAlignment="Center" FontSize="12" CaretBrush="{StaticResource Cyan}"/>
                </Grid>
            </Border>

            <Button Grid.Column="1" Content="⟳ REFRESH" Style="{StaticResource ToolButton}"
                    Command="{Binding RefreshCommand}" Margin="0,0,8,0"/>
            <Button Grid.Column="2" Content="💾 SAVE FILE" Style="{StaticResource ToolButton}"
                    Command="{Binding SaveFileCommand}" Margin="0,0,8,0"/>
            <Button Grid.Column="3" Content="📂 LOAD FILE" Style="{StaticResource ToolButton}"
                    Command="{Binding LoadFileCommand}" Margin="0,0,8,0"/>
            <Button Grid.Column="4" Content="✎ WRITE ALL" Style="{StaticResource ToolButton}"
                    Command="{Binding WriteAllCommand}"
                    Foreground="{StaticResource Orange}"/>
        </Grid>

        <!-- Parameter grid -->
        <DataGrid Grid.Row="1" Margin="8,4"
                  ItemsSource="{Binding ItemsView}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  Background="{StaticResource Panel}" RowBackground="{StaticResource Panel}"
                  AlternatingRowBackground="#12161D"
                  Foreground="{StaticResource Primary}"
                  BorderBrush="{StaticResource Border}" BorderThickness="1"
                  HorizontalGridLinesBrush="{StaticResource Border}"
                  RowHeaderWidth="0" FontSize="12"
                  ColumnWidth="Auto">

            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{StaticResource Card}"/>
                    <Setter Property="Foreground" Value="{StaticResource Secondary}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="10"/>
                    <Setter Property="Padding" Value="8,6"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                </Style>
            </DataGrid.Resources>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Foreground" Value="{StaticResource Primary}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDirty}" Value="True">
                            <Setter Property="Background" Value="#3A2E12"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="8,5"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.CellStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="PARAMETER" Binding="{Binding Name}" IsReadOnly="True"
                                    FontFamily="Consolas"/>
                <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" IsReadOnly="True"
                                    Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource Secondary}"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding Description}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="ONBOARD" Binding="{Binding OnboardText}" IsReadOnly="True"
                                    FontFamily="Consolas">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource Secondary}"/>
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="RANGE" Binding="{Binding RangeText}" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource Secondary}"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="FontSize" Value="11"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="VALUE" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <!-- Numeric editor (shown when the param has no fixed choices) -->
                                <TextBox Text="{Binding EditValue, UpdateSourceTrigger=LostFocus}"
                                         MinWidth="120" Background="#0D1117" BorderBrush="{StaticResource Border}"
                                         BorderThickness="1" Foreground="{StaticResource Primary}"
                                         FontFamily="Consolas" FontSize="13" Padding="6,3" TextAlignment="Right"
                                         CaretBrush="{StaticResource Cyan}"
                                         ToolTip="{Binding Description}">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasOptions}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasBits}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource Orange}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource Orange}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsOutOfRange}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#F85149"/>
                                                    <Setter Property="Foreground" Value="#F85149"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>

                                <!-- Enum selector (shown for parameters with a fixed set of values) -->
                                <ComboBox ItemsSource="{Binding Options}"
                                          SelectedValue="{Binding EditValue, Mode=TwoWay}"
                                          SelectedValuePath="Value"
                                          DisplayMemberPath="Label"
                                          FontSize="12"
                                          ToolTip="{Binding Description}"
                                          Visibility="{Binding HasOptions, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <!-- Bitmask editor (checkbox popup) for *_OPTIONS parameters -->
                                <Grid Visibility="{Binding HasBits, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ToggleButton x:Name="BitButton"
                                                  MinWidth="120" Height="26"
                                                  Background="#0D1117" Foreground="{StaticResource Primary}"
                                                  BorderBrush="{StaticResource Border}" BorderThickness="1"
                                                  Padding="6,0" Cursor="Hand"
                                                  HorizontalContentAlignment="Stretch"
                                                  ToolTip="{Binding Description}">
                                        <DockPanel LastChildFill="True">
                                            <Path DockPanel.Dock="Right" Data="M 0 0 L 4 4 L 8 0 Z"
                                                  Fill="#8B949E" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                            <TextBlock Text="{Binding BitmaskSummary}" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource Primary}" FontSize="11"/>
                                        </DockPanel>
                                    </ToggleButton>
                                    <Popup IsOpen="{Binding IsChecked, ElementName=BitButton, Mode=TwoWay}"
                                           PlacementTarget="{Binding ElementName=BitButton}"
                                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                                           MinWidth="280" MaxWidth="460">
                                        <Border Background="#1C2128" BorderBrush="{StaticResource Border}"
                                                BorderThickness="1" CornerRadius="4" Margin="0,2,0,0">
                                            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding BitOptions}" Margin="8">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox Content="{Binding Label}"
                                                                      IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                                      Foreground="{StaticResource Primary}"
                                                                      Margin="2,4" Cursor="Hand"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="UNITS" Binding="{Binding Units}" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource Cyan}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>

            <DataGrid.GroupStyle>
                <GroupStyle>
                    <GroupStyle.ContainerStyle>
                        <Style TargetType="{x:Type GroupItem}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type GroupItem}">
                                        <Expander IsExpanded="True" Background="{StaticResource Card}"
                                                  BorderThickness="0" Margin="0,2">
                                            <Expander.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold"
                                                               FontSize="12" Foreground="{StaticResource Cyan}"/>
                                                    <TextBlock Text="{Binding ItemCount, StringFormat=' ({0})'}"
                                                               Foreground="{StaticResource Secondary}" FontSize="11"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Expander.Header>
                                            <ItemsPresenter/>
                                        </Expander>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.ContainerStyle>
                </GroupStyle>
            </DataGrid.GroupStyle>
        </DataGrid>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="{StaticResource Card}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,0,0" Padding="10,6">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Secondary}" FontSize="11"/>
        </Border>
    </Grid>
</UserControl>
