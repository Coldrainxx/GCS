<UserControl x:Class="GCS.Views.FlightPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:GCS.Views"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="500">

    <UserControl.Resources>
        <SolidColorBrush x:Key="PanelBackground" Color="#151922"/>
        <SolidColorBrush x:Key="CardBackground" Color="#1C2128"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2D333D"/>
        <SolidColorBrush x:Key="PrimaryText" Color="#E6EDF3"/>
        <SolidColorBrush x:Key="SecondaryText" Color="#8B949E"/>
        <SolidColorBrush x:Key="AccentCyan" Color="#39D0D8"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#3FB950"/>
        <SolidColorBrush x:Key="AccentOrange" Color="#FF9500"/>

        <Style x:Key="MetricCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryText}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>

        <Style x:Key="MetricUnitStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentCyan}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Margin" Value="5,0,0,3"/>
        </Style>

        <!-- Custom Tab Style -->
        <Style x:Key="ModernTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="ModernTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource SecondaryText}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}"
                                BorderThickness="0,0,0,2"
                                BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" 
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentCyan}"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="{Binding DataContext.AttitudeRowHeight, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <!-- Artificial Horizon -->
            <RowDefinition/>
            <!-- Tabbed Content -->
        </Grid.RowDefinitions>

        <!-- ARTIFICIAL HORIZON -->
        <Border Grid.Row="0"
                Background="{StaticResource CardBackground}" 
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                Margin="10,10,10,5">
            <Grid>
                <views:ArtificialHorizon Roll="{Binding Roll}" 
                                        Pitch="{Binding Pitch}"/>

                <!-- Overlay Label -->
                <TextBlock Text="ATTITUDE"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top"
                          Margin="15,15"
                          Style="{StaticResource MetricLabelStyle}"
                          Foreground="{StaticResource PrimaryText}"
                          FontSize="11"/>

                <!-- Which vehicle every tab below is showing. Only meaningful once
                     there is more than one, so it appears in swarm mode. -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="15,12"
                        Background="#CC0D1117" BorderBrush="{StaticResource AccentCyan}"
                        BorderThickness="1" CornerRadius="3" Padding="8,3"
                        Visibility="{Binding DataContext.IsSwarmMode,
                                     RelativeSource={RelativeSource AncestorType=Window},
                                     Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="SHOWING" Foreground="{StaticResource SecondaryText}"
                                   FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DataContext.Swarm.ActiveVehicle.Name,
                                          RelativeSource={RelativeSource AncestorType=Window},
                                          FallbackValue=—, TargetNullValue=—}"
                                   Foreground="{StaticResource AccentCyan}" FontSize="12"
                                   FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Angle Readout -->
                <Border Background="#1C2128" 
                       BorderBrush="{StaticResource BorderBrush}"
                       BorderThickness="1"
                       CornerRadius="4"
                       Padding="10,5"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom"
                       Margin="0,0,0,15">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ROLL: " 
                                  Foreground="{StaticResource SecondaryText}"
                                  FontSize="11"
                                  Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding Roll, StringFormat=F0}" 
                                  Foreground="{StaticResource AccentCyan}"
                                  FontSize="13"
                                  FontWeight="Bold"/>
                        <TextBlock Text="°" 
                                  Foreground="{StaticResource AccentCyan}"
                                  FontSize="11"
                                  Margin="2,0,15,0"/>

                        <TextBlock Text="PITCH: " 
                                  Foreground="{StaticResource SecondaryText}"
                                  FontSize="11"
                                  Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding Pitch, StringFormat=F0}" 
                                  Foreground="{StaticResource AccentCyan}"
                                  FontSize="13"
                                  FontWeight="Bold"/>
                        <TextBlock Text="°" 
                                  Foreground="{StaticResource AccentCyan}"
                                  FontSize="11"
                                  Margin="2,0,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- TABBED PANELS -->
        <TabControl Grid.Row="1"
                    Style="{StaticResource ModernTabControl}"
                    Margin="10,5,10,10"
                    PreviewMouseWheel="Tabs_PreviewMouseWheel">

            <!-- TAB 0: SWARM — only present in swarm mode, so the fleet roster,
                 formation and group commands sit alongside MISSION/DATA/etc.
                 and you never have to leave swarm mode to plan or inspect. -->
            <TabItem x:Name="SwarmTab" Header="SWARM" Style="{StaticResource ModernTabItem}"
                     Visibility="{Binding DataContext.ShowSwarmTab,
                                  RelativeSource={RelativeSource AncestorType=Window},
                                  Converter={StaticResource BoolToVisibilityConverter}}">
                <views:SwarmView DataContext="{Binding DataContext.Swarm,
                                               RelativeSource={RelativeSource AncestorType=Window}}"/>
            </TabItem>

            <!-- TAB 1: DATA (the default tab — see FlightPanelView.OnLoaded) -->
            <TabItem x:Name="DataTab" Header="DATA" Style="{StaticResource ModernTabItem}" Visibility="{Binding DataContext.IsNotLogReviewMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <views:DataTabView DataContext="{Binding}"/>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: MESSAGES -->
            <TabItem Header="MESSAGES" Style="{StaticResource ModernTabItem}" Visibility="{Binding DataContext.IsNotLogReviewMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <views:MessagesTabView DataContext="{Binding DataContext.Messages, RelativeSource={RelativeSource AncestorType=Window}}"/>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: RC CHANNELS -->
            <TabItem Header="RC" Style="{StaticResource ModernTabItem}" Visibility="{Binding DataContext.IsNotLogReviewMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <views:RcChannelsTabView DataContext="{Binding DataContext.RcChannels, RelativeSource={RelativeSource AncestorType=Window}}"/>
                </ScrollViewer>
            </TabItem>

            <!-- TAB: LOG — post-flight review. Lives here rather than in a
                 full-window panel so the flight path can be drawn on the real map
                 alongside it, the way swarm mode works. -->
            <TabItem x:Name="LogTab" Header="LOG" Style="{StaticResource ModernTabItem}"
                     Visibility="{Binding DataContext.IsLogReviewMode,
                                  RelativeSource={RelativeSource AncestorType=Window},
                                  Converter={StaticResource BoolToVisibilityConverter}}">
                <views:LogsView DataContext="{Binding DataContext.Logs,
                                              RelativeSource={RelativeSource AncestorType=Window}}"/>
            </TabItem>

            <!-- TAB: ADVISOR — per-subsystem health assessment. Sits next to PREARM
                 because both answer "should I fly?", but this one keeps answering
                 it during the flight. -->
            <TabItem Header="ADVISOR" Style="{StaticResource ModernTabItem}" Visibility="{Binding DataContext.IsNotLogReviewMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <views:AdvisorTabView DataContext="{Binding DataContext.Advisor, RelativeSource={RelativeSource AncestorType=Window}}"/>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 4: PREARM -->
            <TabItem Header="PREARM" Style="{StaticResource ModernTabItem}" Visibility="{Binding DataContext.IsNotLogReviewMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <views:PrearmTabView DataContext="{Binding DataContext.Preflight, RelativeSource={RelativeSource AncestorType=Window}}"/>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 5: ACTIONS — single-vehicle only. In swarm mode the action bar
                 drives the whole fleet, so per-vehicle arm/mode buttons here would
                 be an ambiguous second place to command one drone. -->
            <TabItem x:Name="ActionsTab" Header="ACTIONS" Style="{StaticResource ModernTabItem}"
                     Visibility="{Binding DataContext.ShowActionsTab,
                                  RelativeSource={RelativeSource AncestorType=Window},
                                  Converter={StaticResource BoolToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <views:ActionsTabView DataContext="{Binding DataContext.Actions, RelativeSource={RelativeSource AncestorType=Window}}"/>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 7: 3D MODEL -->
            <TabItem Header="3D MODEL" Style="{StaticResource ModernTabItem}" Visibility="{Binding DataContext.IsNotLogReviewMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}">
                <views:Model3DTabView Roll="{Binding Roll}"
                                      Pitch="{Binding Pitch}"
                                      Yaw="{Binding Yaw}"/>
            </TabItem>
            <!-- TAB: MISSION -->
            <TabItem Header="MISSION" Style="{StaticResource ModernTabItem}" Visibility="{Binding DataContext.IsNotLogReviewMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <views:MissionTabView DataContext="{Binding DataContext.Mission, RelativeSource={RelativeSource AncestorType=Window}}"/>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
