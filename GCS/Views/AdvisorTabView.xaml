<UserControl x:Class="GCS.Views.AdvisorTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="480">

    <UserControl.Resources>
        <SolidColorBrush x:Key="CardBackground" Color="#1C2128"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2D333D"/>
        <SolidColorBrush x:Key="PrimaryText" Color="#E6EDF3"/>
        <SolidColorBrush x:Key="SecondaryText" Color="#8B949E"/>
        <SolidColorBrush x:Key="MutedText" Color="#5A636D"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#3FB950"/>
        <SolidColorBrush x:Key="AccentRed" Color="#F85149"/>
        <SolidColorBrush x:Key="AccentOrange" Color="#FF9500"/>

        <!-- Status colour is driven by a string key so GCS.Core carries no UI types. -->
        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedText}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusKey}" Value="Ok">
                    <Setter Property="Foreground" Value="{StaticResource AccentGreen}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKey}" Value="Warning">
                    <Setter Property="Foreground" Value="{StaticResource AccentOrange}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKey}" Value="Critical">
                    <Setter Property="Foreground" Value="{StaticResource AccentRed}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="VerdictBadge" TargetType="Border">
            <Setter Property="Background" Value="#252B33"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10,5"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding VerdictKey}" Value="Ok">
                    <Setter Property="Background" Value="#1B3A25"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding VerdictKey}" Value="Warning">
                    <Setter Property="Background" Value="#3D2E14"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding VerdictKey}" Value="Critical">
                    <Setter Property="Background" Value="#48201E"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="VerdictText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedText}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding VerdictKey}" Value="Ok">
                    <Setter Property="Foreground" Value="{StaticResource AccentGreen}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding VerdictKey}" Value="Warning">
                    <Setter Property="Foreground" Value="{StaticResource AccentOrange}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding VerdictKey}" Value="Critical">
                    <Setter Property="Foreground" Value="{StaticResource AccentRed}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="5,5,5,12">
            <TextBlock Text="FLIGHT ADVISOR"
                       Foreground="{StaticResource SecondaryText}"
                       FontSize="11" FontWeight="Bold"/>
            <TextBlock Text="{Binding Headline}"
                       Foreground="{StaticResource PrimaryText}"
                       FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Verdict -->
        <Border Grid.Row="1" Style="{StaticResource VerdictBadge}" Margin="5,0,5,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding VerdictText}" Style="{StaticResource VerdictText}"/>
                    <TextBlock Text="{Binding CoverageText}"
                               Foreground="{StaticResource SecondaryText}"
                               FontSize="10" Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding OverallScoreText}"
                               Foreground="{StaticResource PrimaryText}"
                               FontSize="20" FontWeight="Bold"
                               HorizontalAlignment="Right"/>
                    <TextBlock Text="overall"
                               Foreground="{StaticResource MutedText}"
                               FontSize="9" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Components -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Components}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource CardBackground}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="4"
                                Padding="10,8" Margin="5,0,5,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="{Binding Name}"
                                           Foreground="{StaticResource PrimaryText}"
                                           FontSize="12" FontWeight="SemiBold"/>

                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Text="{Binding ScoreText}"
                                           Foreground="{StaticResource PrimaryText}"
                                           FontSize="12" FontWeight="Bold"/>

                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="{Binding Summary}"
                                           Foreground="{StaticResource SecondaryText}"
                                           FontSize="10" TextWrapping="Wrap"
                                           Margin="0,3,0,0"/>

                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           Text="{Binding Status}"
                                           Style="{StaticResource StatusText}"
                                           VerticalAlignment="Bottom"
                                           Margin="8,3,0,0"/>

                                <TextBlock Grid.Row="2" Grid.ColumnSpan="2"
                                           Text="{Binding Findings}"
                                           Foreground="{StaticResource SecondaryText}"
                                           FontSize="10" TextWrapping="Wrap"
                                           Margin="0,6,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Findings}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Footer. The assistant lives in the floating AssistantPopupView so it
             can be consulted from any tab, not only this one. -->
        <StackPanel Grid.Row="3" Margin="5,10,5,0">
            <TextBlock Foreground="{StaticResource MutedText}" FontSize="9" TextWrapping="Wrap">
                <Run Text="Battery trend:"/>
                <Run Text="{Binding BatteryTrendText, Mode=OneWay}"/>
            </TextBlock>
            <TextBlock Text="Subsystems marked NOT MONITORED are excluded from the overall score."
                       Foreground="{StaticResource MutedText}"
                       FontSize="9" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>

