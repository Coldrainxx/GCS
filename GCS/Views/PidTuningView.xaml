<UserControl x:Class="GCS.Views.PidTuningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="780">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" Foreground="#39D0D8" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" Text="{Binding Description}" TextWrapping="Wrap" Foreground="#8B949E"
                   FontSize="12" Margin="0,0,0,14"/>

        <Button Grid.Row="2" Content="⟳ READ" HorizontalAlignment="Left" Command="{Binding RefreshCommand}"
                Background="#1C2128" Foreground="#E6EDF3" BorderBrush="#2D333D" BorderThickness="1"
                Padding="14,7" FontWeight="Bold" Cursor="Hand" Margin="0,0,0,14"/>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#1C2128" BorderBrush="#2D333D" BorderThickness="1" CornerRadius="6"
                                Padding="14,12" Margin="0,0,12,12" Width="220" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" Foreground="#39D0D8" FontWeight="Bold"
                                           FontSize="13" Margin="0,0,0,10"/>
                                <ItemsControl ItemsSource="{Binding Fields}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,7">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Label}" Foreground="#E6EDF3"
                                                           FontSize="12" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" Width="88" Background="#0D1117"
                                                         Foreground="#E6EDF3" BorderBrush="#2D333D" BorderThickness="1"
                                                         Padding="6,3" TextAlignment="Right" FontFamily="Consolas"
                                                         FontSize="12"
                                                         Text="{Binding Value, UpdateSourceTrigger=LostFocus, StringFormat=0.######}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="4" Text="{Binding Status}" Foreground="#8B949E" FontSize="12" Margin="0,10,0,0"/>
    </Grid>
</UserControl>
